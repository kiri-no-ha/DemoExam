<Page x:Class="DemoExam.Pages.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Список товаров"
      Background="White"
      FontFamily="Calibri">

    <Grid>
        <ListView x:Name="ProductList" Margin="0,50,0,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Width="652" Height="100">
                        <Rectangle Fill="{Binding BackgroundColor}"
                                   Stroke="Black" StrokeThickness="1"/>

                        <Image Source="{Binding ImagePath}"
                               Width="100" Height="80"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>

                        <TextBlock Text="{Binding ManufacturerAndName}"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="{Binding Product.Category.name}"
                                   FontSize="12"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Margin="120,40,0,0"/>

                        <TextBlock Text="{Binding TotalAmount}"
                                   FontSize="12"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Margin="120,60,0,0"/>

                        <TextBlock Text="{Binding Product.composition}"
                                   FontSize="10"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Margin="120,80,0,0"/>

                        <TextBlock Text="{Binding ComputedPrice}"
                                   FontSize="20"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>